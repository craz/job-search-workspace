# Workspace-level Compose port / toggle overrides.
# Copy to `.env` (gitignored) for local port remaps. Defaults match compose.yaml.

# Host-published ports (loopback only in compose.yaml)
CORE_PORT=8000
WEB_PORT=8080
SCORING_PORT=8090
HH_API_PORT=8092
HH_NOVNC_PORT=6080
HH_OAUTH_PORT=8767
AUTOMATION_PORT=8095
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673

# Automation: default OFF (0). Enable from Web UI or set to 1.
AUTOMATION_ENABLED=0
AUTOMATION_INTERVAL_SECONDS=3600
AUTO_SCORING_MAX_PER_CYCLE=20
AUTO_SCORE_MAX_AGE_DAYS=14
AUTOMATION_SUITABLE_MAX_PAGES=1

# RabbitMQ (dev defaults — change if you expose beyond loopback)
RABBITMQ_USER=job_search
RABBITMQ_PASSWORD=job_search
